+Vector<DisplayServerEnums::WindowID> DisplayServerHeadlessEGL::get_window_list() const {
+	Vector<DisplayServerEnums::WindowID> windows;
+	windows.push_back(DisplayServerEnums::MAIN_WINDOW_ID);
+	return windows;
+}
+
+void DisplayServerHeadlessEGL::window_set_size(const Size2i p_size, DisplayServerEnums::WindowID p_window) {
+	ERR_FAIL_COND(p_window != DisplayServerEnums::MAIN_WINDOW_ID);
+	ERR_FAIL_COND(p_size.x <= 0 || p_size.y <= 0);
+	window_size = p_size;
+}
+
+void DisplayServerHeadlessEGL::window_set_vsync_mode(DisplayServerEnums::VSyncMode p_vsync_mode, DisplayServerEnums::WindowID p_window) {
+	ERR_FAIL_COND(p_window != DisplayServerEnums::MAIN_WINDOW_ID);
+	vsync_mode = p_vsync_mode;
+	if (gl_manager != nullptr) {
+		gl_manager->set_use_vsync(vsync_mode != DisplayServerEnums::VSYNC_DISABLED);
+	}
+}
+
+int64_t DisplayServerHeadlessEGL::window_get_native_handle(DisplayServerEnums::HandleType p_handle_type, DisplayServerEnums::WindowID p_window) const {
+	ERR_FAIL_COND_V(p_window != DisplayServerEnums::MAIN_WINDOW_ID, 0);
+	ERR_FAIL_NULL_V(gl_manager, 0);
+
+	if (p_handle_type == DisplayServerEnums::DISPLAY_HANDLE) {
+		return reinterpret_cast<int64_t>(gl_manager->get_display(DisplayServerEnums::MAIN_WINDOW_ID));
+	}
+	if (p_handle_type == DisplayServerEnums::OPENGL_CONTEXT) {
+		return reinterpret_cast<int64_t>(gl_manager->get_context(DisplayServerEnums::MAIN_WINDOW_ID));
+	}
+	return 0;
+}
+
+void DisplayServerHeadlessEGL::release_rendering_thread() {
+	if (gl_manager != nullptr) {
+		gl_manager->release_current();
+	}
+}
+
+void DisplayServerHeadlessEGL::swap_buffers() {
+	if (gl_manager != nullptr) {
+		gl_manager->swap_buffers();
+	}
+}
