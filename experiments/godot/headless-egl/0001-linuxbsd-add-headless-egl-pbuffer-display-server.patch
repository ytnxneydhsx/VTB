+
+DisplayServer *DisplayServerHeadlessEGL::create_func(const String &p_rendering_driver, DisplayServerEnums::WindowMode p_mode, DisplayServerEnums::VSyncMode p_vsync_mode, uint32_t p_flags, const Vector2i *p_position, const Vector2i &p_resolution, int p_screen, DisplayServerEnums::Context p_context, int64_t p_parent_window, Error &r_error) {
+	DisplayServerHeadlessEGL *display_server = memnew(DisplayServerHeadlessEGL(p_rendering_driver, p_resolution, p_vsync_mode, r_error));
+	if (r_error != OK) {
+		memdelete(display_server);
+		return nullptr;
+	}
+	return display_server;
+}
