+void DisplayServerHeadlessEGL::register_headless_egl_driver() {
+	register_create_function("headless_egl", create_func, get_rendering_drivers_func);
+}
+
+DisplayServerHeadlessEGL::DisplayServerHeadlessEGL(const String &p_rendering_driver, const Vector2i &p_resolution, DisplayServerEnums::VSyncMode p_vsync_mode, Error &r_error) {
+	r_error = OK;
+	window_size = p_resolution;
+	vsync_mode = p_vsync_mode;
+
+	if (p_rendering_driver != "opengl3_es") {
+		r_error = ERR_UNAVAILABLE;
+		ERR_FAIL_MSG("Headless EGL requires the opengl3_es rendering driver.");
+	}
+
+	drm_fd = open("/dev/dri/renderD128", O_RDWR | O_CLOEXEC);
+	if (drm_fd < 0) {
+		r_error = ERR_CANT_OPEN;
+		ERR_FAIL_MSG("Could not open /dev/dri/renderD128 for Headless EGL GBM.");
+	}
+
+	gbm = gbm_create_device(drm_fd);
+	if (gbm == nullptr) {
+		r_error = ERR_CANT_CREATE;
+		ERR_FAIL_MSG("Could not create the Headless EGL GBM device.");
+	}
+
+	gl_manager = memnew(GLManagerHeadlessEGL);
+	Error error = gl_manager->initialize(gbm);
+	if (error == OK) {
+		error = gl_manager->open_display(gbm);
+	}
+	if (error == OK) {
+		error = gl_manager->window_create(DisplayServerEnums::MAIN_WINDOW_ID, nullptr, nullptr, window_size.x, window_size.y);
+	}
+	if (error != OK) {
+		memdelete(gl_manager);
+		gl_manager = nullptr;
+		r_error = error;
+		ERR_FAIL_MSG("Could not initialize the Headless EGL Pbuffer.");
+	}
+
+	gl_manager->set_use_vsync(vsync_mode != DisplayServerEnums::VSYNC_DISABLED);
+	RasterizerGLES3::make_current(false);
+}
+
+DisplayServerHeadlessEGL::~DisplayServerHeadlessEGL() {
+	if (gl_manager != nullptr) {
+		gl_manager->window_destroy(DisplayServerEnums::MAIN_WINDOW_ID);
+		memdelete(gl_manager);
+		gl_manager = nullptr;
+	}
+	if (gbm != nullptr) {
+		gbm_device_destroy(gbm);
+		gbm = nullptr;
+	}
+	if (drm_fd >= 0) {
+		close(drm_fd);
+		drm_fd = -1;
+	}
+}
+#endif // GLES3_ENABLED
