diff --git a/platform/linuxbsd/headless_egl/SCsub b/platform/linuxbsd/headless_egl/SCsub
new file mode 100644
index 0000000..6a3701c
--- /dev/null
+++ b/platform/linuxbsd/headless_egl/SCsub
@@ -0,0 +1,24 @@
+#!/usr/bin/env python
+import os
+from misc.utility.scons_hints import *
+
+Import("env")
+
+File = env.File
+
+board_sysroot = os.environ.get("OPENVT_BOARD_SYSROOT")
+if not board_sysroot:
+    raise RuntimeError("OPENVT_BOARD_SYSROOT is required for Headless EGL GBM")
+
+mali_root = os.path.join(
+    board_sysroot,
+    "opt/rockchip/libmali-g13p0-x11-gbm-1.9-1/usr/lib/aarch64-linux-gnu",
+)
+env.Append(LIBPATH=[mali_root, os.path.join(mali_root, "mali")])
+env.Append(LIBS=["gbm", "mali"])
+
+source_files = [
+    File("display_server_headless_egl.cpp"),
+]
+
+Return("source_files")
