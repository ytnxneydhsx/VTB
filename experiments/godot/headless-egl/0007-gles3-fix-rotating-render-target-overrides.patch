diff --git a/drivers/gles3/storage/texture_storage.cpp b/drivers/gles3/storage/texture_storage.cpp
--- a/drivers/gles3/storage/texture_storage.cpp
+++ b/drivers/gles3/storage/texture_storage.cpp
@@ -2832,7 +2832,14 @@ void TextureStorage::_clear_render_target(RenderTarget *rt) {
 
 	// Dispose of the cached fbo's and the allocated textures
 	for (KeyValue<uint32_t, RenderTarget::RTOverridden::FBOCacheEntry> &E : rt->overridden.fbo_cache) {
-		glDeleteTextures(E.value.allocated_textures.size(), E.value.allocated_textures.ptr());
+		for (GLuint allocated_texture : E.value.allocated_textures) {
+			// The currently attached textures are released by the normal render-target
+			// cleanup below. Release every other cached attachment through Utilities so
+			// its allocation accounting is removed together with the GL object.
+			if (allocated_texture != rt->color && allocated_texture != rt->depth) {
+				GLES3::Utilities::get_singleton()->texture_free_data(allocated_texture);
+			}
+		}
 		// Don't delete the current FBO, we'll do that a couple lines down.
 		if (E.value.fbo != rt->fbo) {
 			glDeleteFramebuffers(1, &E.value.fbo);
@@ -2984,6 +2991,24 @@ void TextureStorage::render_target_set_override(RID p_render_target, RID p_color_
 	if (rt->overridden.color == p_color_texture && rt->overridden.depth == p_depth_texture && rt->overridden.velocity == p_velocity_texture && rt->overridden.velocity_depth == p_velocity_depth_texture) {
 		return;
 	}
+	if (p_color_texture.is_valid() && rt->overridden.color.is_valid() && rt->overridden.color != p_color_texture) {
+		Texture *previous_color = get_texture(rt->overridden.color);
+		if (previous_color != nullptr && previous_color->render_target == rt) {
+			previous_color->render_target = nullptr;
+			previous_color->is_render_target = false;
+		}
+	}
+	if (p_color_texture.is_null() && p_depth_texture.is_null() && p_velocity_texture.is_null() && p_velocity_depth_texture.is_null()) {
+		// Restore the render target's owned attachments and leave the override state
+		// fully cleared. Continuing through the generic override path would set
+		// is_overridden again with four null RIDs and corrupt later target teardown.
+		if (was_color_texture.is_valid()) {
+			texture_remap_proxies(was_color_texture, rt->texture);
+		}
+		_clear_render_target(rt);
+		_update_render_target_color(rt);
+		return;
+	}
 
 	if (p_color_texture.is_null() && p_depth_texture.is_null()) {
 		// Set this back to our default textures.
@@ -3024,7 +3049,11 @@ void TextureStorage::render_target_set_override(RID p_render_target, RID p_color_
 		rt->depth = cache->get().depth;
 		rt->depth_has_stencil = cache->get().depth_has_stencil;
 		rt->size = cache->get().size;
-		rt->texture = p_color_texture;
+		Texture *color_texture = get_texture(p_color_texture);
+		if (color_texture != nullptr) {
+			color_texture->render_target = rt;
+			color_texture->is_render_target = true;
+		}
 		create_new_color_fbo = false;
 	}
 
