#!/usr/bin/env python

import os

Import("env")
Import("env_modules")

board_sysroot = os.environ["OPENVT_BOARD_SYSROOT"]

env_openvt = env_modules.Clone()
env_openvt.Append(
    CPPPATH=[
        board_sysroot + "/usr/include",
        board_sysroot + "/usr/include/rockchip",
        board_sysroot + "/usr/include/rga",
    ]
)

module_obj = []
env_openvt.add_source_files(module_obj, "*.cpp")
env.modules_sources += module_obj

env.Append(
    LIBPATH=[board_sysroot + "/usr/lib/aarch64-linux-gnu"],
    LIBS=["rga", "rockchip_mpp"],
    LINKFLAGS=["-Wl,--allow-shlib-undefined"],
)

