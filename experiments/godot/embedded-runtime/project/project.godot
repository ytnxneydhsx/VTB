; Product bootstrap project for the VTB-owned LibGodot process.
; It intentionally contains no GDScript autoloads or business scene logic.

config_version=5

[application]

config/name="VTB Embedded Live2D"
run/main_scene="res://empty.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080

[rendering]

driver/threads/thread_model=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
