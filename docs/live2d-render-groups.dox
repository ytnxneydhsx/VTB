 */
/** @class vtb::LibGodotInstance
 * @ingroup live2d_render_coordination
 */
/** @class vtb::EmbeddedLive2DApplication
 * @ingroup live2d_render_runtime
 */
/** @class vtb::Live2DRenderSession
 * @ingroup live2d_render_runtime
 */
/** @class OpenVTDmaBufCapture
 * @ingroup live2d_render_runtime
 */
/** @class vtb::RgbaFrameLease
 * @ingroup live2d_render_rgba
 */
