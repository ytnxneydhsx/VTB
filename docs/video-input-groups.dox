 */

/**
 * @class vtb::LatestFrameSlot
 * @ingroup video_input_handoff
 * @brief 最多保存一个 DecodedFrameLease 的线程安全交接槽。
 */

/**
 * @class vtb::VideoStreamControlProtocol
 * @ingroup video_input_handoff
 * @brief 控制线程与消费线程之间不可丢失的源生命周期请求/应答通道。
 */

