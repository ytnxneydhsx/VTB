/**
 * @defgroup video_input 视频输入模块
 * @brief 统一视频源接口、视频帧视图、帧租约以及采集缓冲区生命周期。
 *
 * 推荐阅读顺序：
 *
 * 1. @ref vtb::VideoSource "VideoSource"：视频输入统一入口。
 * 2. @ref vtb::CameraSource "CameraSource"：产品直接 V4L2 摄像头实现。
 * 3. @ref vtb::DecodedFrameLease "DecodedFrameLease"：一帧视频的生命周期控制。
 * 4. @ref vtb::FrameView "FrameView" 和
 *    @ref vtb::FramePlaneView "FramePlaneView"：帧与图像平面元数据。
 * 5. @ref vtb::LatestFrameSlot "LatestFrameSlot"：采集线程与消费线程之间的最新帧交接。
 * 6. @ref vtb::VideoStreamControlProtocol "VideoStreamControlProtocol"：不可丢失的
 *    源开始、退休和消费线程关闭请求/应答。
 * 7. @ref vtb::VideoFrameConsumer "VideoFrameConsumer" 和
 *    @ref vtb::VideoProcessingRuntime "VideoProcessingRuntime"：统一消费接口与通用运行时。
 * 8. @ref vtb::FaceFrameConsumer "FaceFrameConsumer"：人脸管线消费适配器。
 * 9. @ref face_data "人脸数据" 与 @ref face_processing "人脸处理"：人脸值类型、
 *    单帧算法和消费适配边界。
 * 10. @ref application_composition "应用装配"：产品会话、HTTP 控制和输出生命周期。
 *
 * @par 核心数据路径
 *
 * @code
 * VideoSource::read()
 *     -> DecodedFrameLease
 *     -> LatestFrameSlot
 *     -> VideoFrameConsumer::consume()
 *
 * VideoStreamControlProtocol
 *     -> begin_source request/reply
 *     -> retire_source request/reply
 *     -> shutdown_consumer request/reply
 * @endcode
 */

/**
 * @defgroup video_input_api 公共接口
 * @ingroup video_input
 * @brief 调用视频输入模块时首先阅读的稳定类型。
 */

/**
 * @defgroup video_input_sources 视频源实现
 * @ingroup video_input
 * @brief 直接 V4L2 摄像头输入实现。
 */

/**
 * @defgroup video_input_handoff 帧传递
 * @ingroup video_input
 * @brief 在线程之间以 latest-only 策略传递帧租约。
 */

/**
 * @defgroup video_input_consumers 帧消费
 * @ingroup video_input
 * @brief 通用帧消费者、latest-only 运行时和具体业务适配器。
 */

/**
 * @defgroup face_data 人脸数据
 * @ingroup video_input
 * @brief 检测、关键点、姿态、表情和跟踪结果值类型。
 */

/**
 * @defgroup face_processing 人脸处理
 * @ingroup video_input
 * @brief 人脸算法接口、单帧 Pipeline 和消费适配器。
 */

/**
 * @defgroup video_input_config 配置类型
 * @ingroup video_input
 * @brief 视频设备请求参数。
 */

/**
 * @defgroup video_input_internal 内部实现
 * @ingroup video_input
 * @brief 视频源内部状态、V4L2 设备与缓冲池实现细节。
 */

/**
 * @class vtb::VideoSource
 * @ingroup video_input_api
 * @brief 视频输入模块的抽象入口。
 *
 * 调用方只依赖该接口，通过 read() 取得 DecodedFrameLease，并通过
 * request_stop() 与 close() 控制视频源生命周期。
 */

/**
 * @class vtb::DecodedFrameLease
 * @ingroup video_input_api
 */

/**
 * @class vtb::FrameView
