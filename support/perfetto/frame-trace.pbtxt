# Sized for bursts between 10-second writes. Check TraceStats when adding categories.
buffers {
  size_kb: 65536
  fill_policy: RING_BUFFER
}
data_sources {
  config {
    name: "track_event"
    track_event_config {
      disabled_categories: "*"
      enabled_categories: "vtb.thread_frame_trace_flow"
    }
  }
}
unique_session_name: "vtb-frame"
write_into_file: true
file_write_period_ms: 10000
max_file_size_bytes: 134217728
