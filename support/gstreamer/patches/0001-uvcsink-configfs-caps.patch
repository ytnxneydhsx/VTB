+
+#define SIMPLIFY_FRACTION_N_TERMS   8
+#define SIMPLIFY_FRACTION_THRESHOLD 333
+
+static GstCaps *
+gst_uvc_sink_get_configfs_caps (GstUvcSink * self)
+{
+  GstCaps *caps;
+  unsigned int format_index;
+
+  if (!self->fc)
+    return NULL;
+
+  caps = gst_caps_new_empty ();
+  for (format_index = 0;
+      format_index < self->fc->streaming.num_formats; ++format_index) {
+    const struct uvc_function_config_format *format =
+        &self->fc->streaming.formats[format_index];
+    unsigned int frame_index;
+
+    for (frame_index = 0; frame_index < format->num_frames; ++frame_index) {
+      const struct uvc_function_config_frame *frame =
+          &format->frames[frame_index];
+      unsigned int interval_index;
+
+      for (interval_index = 0;
+          interval_index < frame->num_intervals; ++interval_index) {
+        GstStructure *structure;
+        gint numerator = 10000000;
+        gint denominator = frame->intervals[interval_index];
+
+        if (!denominator)
+          continue;
+
+        structure = gst_v4l2uvc_fourcc_to_bare_struct (format->fcc);
+        if (!structure)
+          continue;
+
+        gst_util_simplify_fraction (&numerator, &denominator,
+            SIMPLIFY_FRACTION_N_TERMS, SIMPLIFY_FRACTION_THRESHOLD);
+        gst_structure_set (structure,
+            "width", G_TYPE_INT, (gint) frame->width,
+            "height", G_TYPE_INT, (gint) frame->height,
+            "framerate", GST_TYPE_FRACTION, numerator, denominator, NULL);
+        gst_caps_append_structure (caps, structure);
+      }
+    }
+  }
+
+  return caps;
 }

