From: VTB Project <vtb@example.invalid>
Subject: [PATCH] rockchipmpp: import DMA-BUF handles before RGA conversion

The target BSP rejects a raw fd that is deferred through wrapbuffer_fd_t when
the shared input descriptor changes concurrently. Import both DMA-BUFs into
RGA handles before constructing the image descriptors. The handles pin the
buffers for the synchronous request and match the RGA API used by VTB's
existing transform path.

diff --git a/gst/rockchipmpp/gstmpprga.c b/gst/rockchipmpp/gstmpprga.c
index 5247f15..3d6920d 100644
--- a/gst/rockchipmpp/gstmpprga.c
+++ b/gst/rockchipmpp/gstmpprga.c
@@ -171,6 +171,37 @@ gst_mpp_rga_buffer_from_video_info (GstVideoInfo * vinfo, gint fd,
       fd, vir_addr, width, height, hstride, vstride);
 }
 
+static rga_buffer_t
+gst_mpp_rga_buffer_from_video_info_handle (GstVideoInfo * vinfo,
+    rga_buffer_handle_t handle)
+{
+  GstVideoFormat format = GST_VIDEO_INFO_FORMAT (vinfo);
+  guint width = GST_VIDEO_INFO_WIDTH (vinfo);
+  guint height = GST_VIDEO_INFO_HEIGHT (vinfo);
+  guint hstride = gst_mpp_get_pixel_stride (vinfo);
+  guint vstride = GST_MPP_VIDEO_INFO_VSTRIDE (vinfo);
+  RgaSURF_FORMAT rga_format = gst_mpp_gst_format_to_rga_format (format);
+
+  if (!handle || rga_format == RK_FORMAT_UNKNOWN)
+    return (rga_buffer_t) {
+    0};
+
+  return wrapbuffer_handle_t (handle, width, height, hstride, vstride,
+      rga_format);
+}
+
+static rga_buffer_handle_t
+gst_mpp_rga_import_video_info (GstVideoInfo * vinfo, gint fd)
+{
+  im_handle_param_t param = { 0, };
+
+  param.width = gst_mpp_get_pixel_stride (vinfo);
+  param.height = GST_MPP_VIDEO_INFO_VSTRIDE (vinfo);
+  param.format = gst_mpp_gst_format_to_rga_format (
+      GST_VIDEO_INFO_FORMAT (vinfo));
+  return importbuffer_fd (fd, &param);
+}
+
 gboolean
 gst_mpp_rga_convert (GstBuffer * inbuf, GstVideoInfo * src_vinfo,
     GstMemory * out_mem, GstVideoInfo * dst_vinfo, gint rotation)
@@ -181,6 +212,8 @@ gst_mpp_rga_convert (GstBuffer * inbuf, GstVideoInfo * src_vinfo,
   gint fd = -1;
   void *vir_addr = NULL;
   gint source_fd = -1;
+  rga_buffer_handle_t source_handle = 0;
+  rga_buffer_handle_t destination_handle = 0;
 
   /* Prefer using dma fd */
   if (gst_buffer_n_memory (inbuf) == 1) {
@@ -200,9 +233,15 @@ gst_mpp_rga_convert (GstBuffer * inbuf, GstVideoInfo * src_vinfo,
     vir_addr = mapinfo.data;
   }
 
-  src = gst_mpp_rga_buffer_from_video_info (src_vinfo, fd, vir_addr);
-  dst = gst_mpp_rga_buffer_from_video_info (dst_vinfo,
-      gst_dmabuf_memory_get_fd (out_mem), NULL);
+  if (fd >= 0)
+    source_handle = gst_mpp_rga_import_video_info (src_vinfo, fd);
+  destination_handle = gst_mpp_rga_import_video_info (dst_vinfo,
+      gst_dmabuf_memory_get_fd (out_mem));
+
+  src = gst_mpp_rga_buffer_from_video_info_handle (src_vinfo,
+      source_handle);
+  dst = gst_mpp_rga_buffer_from_video_info_handle (dst_vinfo,
+      destination_handle);
 
   ret = src.wstride && dst.wstride &&
       gst_mpp_rga_do_convert (&src, &dst, rotation);
@@ -210,6 +249,10 @@ gst_mpp_rga_convert (GstBuffer * inbuf, GstVideoInfo * src_vinfo,
   gst_buffer_unmap (inbuf, &mapinfo);
+  if (source_handle)
+    releasebuffer_handle (source_handle);
+  if (destination_handle)
+    releasebuffer_handle (destination_handle);
   if (source_fd >= 0)
     close (source_fd);
   return ret;
 }

