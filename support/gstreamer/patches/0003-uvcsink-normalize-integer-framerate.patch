 #define SIMPLIFY_FRACTION_N_TERMS   8
 #define SIMPLIFY_FRACTION_THRESHOLD 333
+#define UVC_INTERVALS_PER_SECOND     10000000U
+#define UVC_INTEGER_FPS_MAX_ERROR    100U
+
+static void
+gst_uvc_sink_interval_to_framerate (unsigned int interval,
+    gint * numerator, gint * denominator)
+{
+  guint64 rounded_fps;
+  guint64 represented_intervals;
+  guint64 difference;
+
+  *numerator = UVC_INTERVALS_PER_SECOND;
+  *denominator = interval;
+
+  rounded_fps = (UVC_INTERVALS_PER_SECOND + interval / 2) / interval;
+  represented_intervals = rounded_fps * interval;
+  if (represented_intervals >= UVC_INTERVALS_PER_SECOND)
+    difference = represented_intervals - UVC_INTERVALS_PER_SECOND;
+  else
+    difference = UVC_INTERVALS_PER_SECOND - represented_intervals;
+
+  if (rounded_fps > 0 && rounded_fps <= G_MAXINT &&
+      difference <= UVC_INTEGER_FPS_MAX_ERROR) {
+    *numerator = rounded_fps;
+    *denominator = 1;
+    return;
+  }
+
+  gst_util_simplify_fraction (numerator, denominator,
+      SIMPLIFY_FRACTION_N_TERMS, SIMPLIFY_FRACTION_THRESHOLD);
+}

