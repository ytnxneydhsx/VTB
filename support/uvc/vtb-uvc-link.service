[Unit]
Description=VTB persistent UVC Gadget link
Requires=rk3588-usb-gadget.service
After=rk3588-usb-gadget.service
Before=vtb-live2d.service

[Service]
Type=simple
User=huangnv
Group=huangnv
SupplementaryGroups=video
RuntimeDirectory=vtb
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
Environment=VTB_UVC_LINK_FIFO=/run/vtb/uvc-link.mjpeg
Environment=VTB_UVC_DEVICE=/dev/video2
Environment=VTB_UVC_WIDTH=1920
Environment=VTB_UVC_HEIGHT=1080
Environment=VTB_UVC_FPS=60
Environment=VTB_GSTREAMER_ROOT=/opt/vtb/gstreamer-1.28.9
ExecStart=/usr/local/sbin/vtb-uvc-link
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
